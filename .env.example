# Read by docker-compose.yml for the postgres/server/web services.
POSTGRES_PASSWORD="generate-a-long-random-string"

# Signs the socket auth token; must be identical for apps/web and apps/server.
# Generate with: openssl rand -hex 32
JWT_SECRET="generate-a-long-random-string"

# NextAuth session secret.
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string"
