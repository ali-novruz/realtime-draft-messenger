# Postgres connection (matches apps/server's DATABASE_URL/DIRECT_URL).
DATABASE_URL="postgresql://user:password@postgres:5432/livedraft?schema=public"
DIRECT_URL="postgresql://user:password@postgres:5432/livedraft?schema=public"

# Must be identical to apps/server's JWT_SECRET — signs the socket auth token
# embedded in the NextAuth session.
# Generate with: openssl rand -hex 32
JWT_SECRET="generate-a-long-random-string"

# NextAuth v5 session secret.
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string"

# Required behind a reverse proxy (Traefik/Nginx) so NextAuth trusts the
# forwarded host/proto headers instead of rejecting the request.
AUTH_TRUST_HOST="true"

# Socket.io server URL. Defaults to same-origin in the browser, which is
# correct when Traefik reverse-proxies both web and server on one domain
# (see docker-compose.yml's PathPrefix(/socket.io) routing) — only set this
# explicitly if serving them from different hosts.
NEXT_PUBLIC_SOCKET_URL=""
