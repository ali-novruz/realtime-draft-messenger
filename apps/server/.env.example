# Postgres connection (must match DATABASE_URL used by apps/web / packages/database)
DATABASE_URL="postgresql://user:password@postgres:5432/livedraft?schema=public"
DIRECT_URL="postgresql://user:password@postgres:5432/livedraft?schema=public"

# Standard redis:// URL — any Redis server works, not just Upstash.
# Draft persistence across brief disconnects is skipped (with a warning) if unset.
REDIS_URL="redis://redis:6379"

PORT=3001

# Comma-separated list of allowed CORS origins (the web app's public URL).
CORS_ORIGIN="https://chat.alinovruz.tech"

# Must be identical to apps/web's JWT_SECRET — signs/verifies the socket auth token.
# Generate with: openssl rand -hex 32
JWT_SECRET="generate-a-long-random-string"
