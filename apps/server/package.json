        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.3",
        "redis": "^4.6.13",
        "socket.io": "^4.7.4"
    },
    "devDependencies": {
        "@types/bcryptjs": "^3.0.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.11.16",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3"
